  "connectors": [
    {
      "id": "feishu",
      "name": "飞书 / Lark",
      "description": "消息、云文档、日历与任务。适合催办、纪要与协作。",
      "category": "im",
      "kind": "tool+skill",
      "docsUrl": "https://open.feishu.cn/document",
      "authUrl": "https://open.feishu.cn/app",
      "credentials": [
        {
          "key": "APP_ID",
          "label": "App ID",
          "required": true
        },
        {
          "key": "APP_SECRET",
          "label": "App Secret",
          "secret": true,
          "required": true
        }
      ],
      "mcp": {
        "name": "feishu",
        "command": "npx",
        "args": [
          "-y",
          "@larksuiteoapi/lark-mcp",
          "mcp",
          "-m",
          "stdio"
        ],
        "envFromCredentials": [
          "APP_ID",
          "APP_SECRET"
        ]
      },
      "skill": {
        "name": "feishu-office",
        "description": "Use Feishu/Lark tools for messaging, docs, and calendar.",
        "body": "# 飞书办公助手\n\n用户提到飞书/Lark 时优先使用已安装的飞书连接器工具。\n发送消息或改文档前先确认对象与内容；勿泄露密钥。\n"
      },
      "securityNotice": "以你的企业应用身份访问数据。请用最小权限应用，勿分享 App Secret。"
    },
