      "levels": ["low", "medium", "high"],
      "default": "medium"
    },
    {
      "match": "grok-[3-9]*",
      "wire": "openai",
      "levels": ["low", "medium", "high"],
      "default": "medium"
    },
    {
      "match": "qwen[3-9]*",
      "wire": "openai",
      "levels": ["low", "medium", "high"],
      "default": "medium"
    }
  ]
}
