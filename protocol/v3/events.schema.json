{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CodePilot Harness Event (v3)",
  "description": "Append-only event log entry. One JSON object per line (NDJSON).",
  "type": "object",
  "required": ["type", "seq", "ts"],
  "properties": {
    "type": { "type": "string", "enum": [
      "run_started",
      "user_message_added",
      "assistant_message_added",
      "tool_result_added",
      "permission_decision_recorded",
      "compaction_applied",
      "run_finished"
    ]},
    "seq": { "type": "integer", "minimum": 0, "description": "Monotonic sequence number assigned by SessionStore on append." },
    "ts": { "type": "integer", "minimum": 0, "description": "Unix epoch milliseconds." }
  },
  "allOf": [
    {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": { "const": "run_started" },
            "session_id": { "type": "string" },
            "goal": { "type": "string" }
          },
          "required": ["type", "session_id", "goal"]
        },
        {
          "type": "object",
          "properties": {
            "type": { "const": "user_message_added" },
            "text": { "type": "string" }
          },
          "required": ["type", "text"]
        },
        {
          "type": "object",
          "properties": {
            "type": { "const": "assistant_message_added" },
            "text": { "type": "string" },
            "tool_calls": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "call_id": { "type": "string" },
                  "name": { "type": "string" },
                  "arguments_json": { "type": "string" }
                },
                "required": ["call_id", "name", "arguments_json"]
              }
            }
          },
          "required": ["type", "text"]
        },
        {
          "type": "object",
          "properties": {
            "type": { "const": "tool_result_added" },
            "call_id": { "type": "string" },
            "tool": { "type": "string" },
            "ok": { "type": "boolean" },
            "output": { "type": "string" },
            "truncated": { "type": "boolean" }
          },
          "required": ["type", "call_id", "tool", "ok", "output"]
        },
        {
          "type": "object",
          "properties": {
            "type": { "const": "permission_decision_recorded" },
            "call_id": { "type": "string" },
            "tool": { "type": "string" },
            "verdict": { "type": "string", "enum": ["allow", "ask", "deny"] },
            "reason": { "type": ["string", "null"] }
          },
          "required": ["type", "call_id", "tool", "verdict"]
        },
        {
          "type": "object",
          "properties": {
            "type": { "const": "compaction_applied" },
            "summary": { "type": "string" },
            "dropped_messages": { "type": "integer", "minimum": 0 }
          },
          "required": ["type", "summary", "dropped_messages"]
        },
        {
          "type": "object",
          "properties": {
            "type": { "const": "run_finished" },
            "status": { "type": "string", "enum": ["completed", "max_steps_reached", "error"] },
            "total_steps": { "type": "integer", "minimum": 0 },
            "detail": { "type": ["string", "null"] }
          },
          "required": ["type", "status", "total_steps"]
        }
      ]
    }
  ]
}
