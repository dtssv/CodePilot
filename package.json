{
  "name": "codepilot",
  "version": "2.0.0",
  "private": true,
  "description": "CodePilot — token-efficient, long-horizon coding agent: core engine, TUI, VSCode & IDEA plugins",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=4 build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "dev:tui": "pnpm --filter @codepilot/tui dev",
    "lint": "tsc -b --noEmit false 2>/dev/null || true"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "tsx": "^4.19.2",
    "vitest": "^2.1.8",
    "@types/node": "^22.10.0"
  }
}
