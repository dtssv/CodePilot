{
  "name": "codepilot",
  "version": "1.0.0",
  "private": true,
  "description": "CodePilot — token-efficient, long-horizon coding agent: core engine, CLI/TUI, web, desktop agent, VSCode & IDEA plugins",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "corepack pnpm -r --workspace-concurrency=4 build",
    "typecheck": "corepack pnpm -r typecheck",
    "test": "corepack pnpm -r test",
    "test:coverage": "corepack pnpm -r test:coverage",
    "dev:tui": "corepack pnpm --filter @codepilot/tui dev",
    "agent": "node packages/protocol/dist/cli.js agent",
    "desktop": "corepack pnpm --filter @codepilot/desktop start",
    "package:vscode": "corepack pnpm --filter codepilot-vscode build && corepack pnpm --filter codepilot-vscode package",
    "package:idea": "cd apps/idea && ./gradlew buildPlugin",
    "package:npm": "corepack pnpm -C packages/core pack && corepack pnpm -C packages/protocol pack && corepack pnpm -C apps/tui pack",
    "package:cli": "node scripts/package/cli.mjs",
    "package:web": "node scripts/package/web.mjs",
    "package:tui": "node scripts/package/tui.mjs",
    "package:desktop": "node scripts/package/desktop.mjs",
    "package:all": "node scripts/package/all.mjs",
    "lint": "biome lint packages/ apps/",
    "lint:ci": "biome lint --max-diagnostics=0 --diagnostic-level=error packages/ apps/",
    "lint:fix": "biome lint --write packages/ apps/",
    "format": "biome format --write packages/ apps/"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@types/node": "^22.10.0",
    "@yao-pkg/pkg": "^6.23.0",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
