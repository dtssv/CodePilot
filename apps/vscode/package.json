{
  "name": "codepilot-vscode",
  "displayName": "CodePilot",
  "description": "Token-efficient, long-horizon coding agent — CodePilot VSCode client",
  "publisher": "codepilot",
  "version": "2.1.1",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/codepilot/codepilot.git",
    "directory": "apps/vscode"
  },
  "type": "module",
  "main": "./dist/extension.js",
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=20"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "codepilot.openSidebar",
        "title": "CodePilot: Open Chat",
        "category": "CodePilot",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "codepilot.newSession",
        "title": "CodePilot: New Session",
        "category": "CodePilot"
      },
      {
        "command": "codepilot.cancel",
        "title": "CodePilot: Cancel Running Prompt",
        "category": "CodePilot"
      },
      {
        "command": "codepilot.switchMode",
        "title": "CodePilot: Switch Mode",
        "category": "CodePilot"
      },
      {
        "command": "codepilot.askSelection",
        "title": "CodePilot: Ask about selection",
        "category": "CodePilot"
      },
      {
        "command": "codepilot.explainFile",
        "title": "CodePilot: Explain this file",
        "category": "CodePilot"
      },
      {
        "command": "codepilot.fixFile",
        "title": "CodePilot: Fix this file",
        "category": "CodePilot"
      },
      {
        "command": "codepilot.showOutput",
        "title": "CodePilot: Show Output Channel",
        "category": "CodePilot"
      },
      {
        "command": "codepilot.checkUpdates",
        "title": "CodePilot: Check Extension Update",
        "category": "CodePilot"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codepilot",
          "title": "CodePilot",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "codepilot": [
        {
          "type": "webview",
          "id": "codepilot.chatView",
          "name": "Chat",
          "contextualTitle": "CodePilot"
        }
      ]
    },
    "configuration": {
      "title": "CodePilot",
      "properties": {
        "codepilot.serverPath": {
          "type": "string",
          "default": "codepilot",
          "description": "Path to the system `codepilot` CLI (fallback when the bundled engine is missing). Used for `engineMode: shared` spawn and `stdio` mode."
        },
        "codepilot.cliPath": {
          "type": "string",
          "default": "",
          "description": "Optional path to a CodePilot CLI entry (cli.js / codepilot-cli.cjs). When empty, the extension uses the bundled engine under resources/, then falls back to serverPath."
        },
        "codepilot.nodePath": {
          "type": "string",
          "default": "node",
          "description": "Path to the node executable used to launch the bundled / cliPath engine."
        },
        "codepilot.engineMode": {
          "type": "string",
          "enum": [
            "shared",
            "stdio"
          ],
          "default": "shared",
          "description": "shared (default): attach to an existing local CodePilot daemon or spawn the bundled one over WebSocket. stdio: private legacy `codepilot serve` process (debug)."
        },
        "codepilot.permissionMode": {
          "type": "string",
          "enum": [
            "ask",
            "auto-edit",
            "yolo"
          ],
          "default": "ask",
          "description": "Default permission mode passed during the `initialize` handshake."
        },
        "codepilot.model": {
          "type": "string",
          "default": "",
          "description": "Optional default model id passed to `session/new` (e.g. claude-sonnet-4.5)."
        },
        "codepilot.provider": {
          "type": "string",
          "enum": [
            "anthropic",
            "openai",
            "copilot",
            ""
          ],
          "default": "",
          "description": "Optional default provider name."
        },
        "codepilot.systemPromptExtra": {
          "type": "string",
          "default": "",
          "description": "Extra system prompt text appended to every new session."
        },
        "codepilot.autoApprove": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Tool names or bash command regexes that auto-approve."
        },
        "codepilot.showDiff": {
          "type": "boolean",
          "default": true,
          "description": "When true, edit_file/write_file tool calls open a vscode.diff tab."
        },
        "codepilot.protocolVersion": {
          "type": "number",
          "default": 1,
          "description": "Headless protocol version to negotiate."
        },
        "codepilot.agentMode": {
          "type": "string",
          "enum": [
            "chat",
            "plan",
            "agent"
          ],
          "default": "agent",
          "description": "Default collaboration mode for new sessions (Ask / Plan / Agent). The webview and `CodePilot: Switch Mode` can override this at runtime; `session/setMode` is supported on an open session."
        }
      }
    },
    "keybindings": [
      {
        "command": "codepilot.openSidebar",
        "key": "ctrl+shift+c",
        "mac": "cmd+shift+c",
        "when": "editorTextFocus"
      },
      {
        "command": "codepilot.askSelection",
        "key": "ctrl+shift+l",
        "mac": "cmd+shift+l",
        "when": "editorHasSelection"
      },
      {
        "command": "codepilot.cancel",
        "key": "escape",
        "when": "codepilot.busy"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "codepilot.askSelection",
          "when": "editorHasSelection",
          "group": "codepilot"
        }
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "package": "vsce package --no-dependencies",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@codepilot/web": "workspace:*",
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.90.0",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^2.1.8",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
