{
  "name": "codepilot-vscode",
  "displayName": "%codepilot.displayName%",
  "description": "%codepilot.description%",
  "publisher": "codepilot",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dtssv/CodePilot.git",
    "directory": "apps/vscode"
  },
  "type": "module",
  "icon": "media/icon-128.png",
  "main": "./dist/extension.cjs",
  "engines": {
    "vscode": "^1.106.0",
    "node": ">=20"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "codepilot.openSidebar",
        "title": "%codepilot.command.openSidebar.title%",
        "category": "CodePilot",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "codepilot.newSession",
        "title": "%codepilot.command.newSession.title%",
        "category": "CodePilot"
      },
      {
        "command": "codepilot.cancel",
        "title": "%codepilot.command.cancel.title%",
        "category": "CodePilot"
      },
      {
        "command": "codepilot.switchMode",
        "title": "%codepilot.command.switchMode.title%",
        "category": "CodePilot"
      },
      {
        "command": "codepilot.addToChat",
        "title": "%codepilot.command.addToChat.title%",
        "category": "CodePilot"
      },
      {
        "command": "codepilot.addToNewChat",
        "title": "%codepilot.command.addToNewChat.title%",
        "category": "CodePilot"
      },
      {
        "command": "codepilot.askSelection",
        "title": "%codepilot.command.askSelection.title%",
        "category": "CodePilot"
      },
      {
        "command": "codepilot.explainFile",
        "title": "%codepilot.command.explainFile.title%",
        "category": "CodePilot"
      },
      {
        "command": "codepilot.fixFile",
        "title": "%codepilot.command.fixFile.title%",
        "category": "CodePilot"
      },
      {
        "command": "codepilot.showOutput",
        "title": "%codepilot.command.showOutput.title%",
        "category": "CodePilot"
      },
      {
        "command": "codepilot.checkUpdates",
        "title": "%codepilot.command.checkUpdates.title%",
        "category": "CodePilot"
      },
      {
        "command": "codepilot.openSettings",
        "title": "%codepilot.command.openSettings.title%",
        "category": "CodePilot"
      },
      {
        "command": "codepilot.openIdeSettings",
        "title": "%codepilot.command.openIdeSettings.title%",
        "category": "CodePilot"
      },
      {
        "command": "codepilot.setApiKey",
        "title": "%codepilot.command.setApiKey.title%",
        "category": "CodePilot"
      },
      {
        "command": "codepilot.editUserConfig",
        "title": "%codepilot.command.editUserConfig.title%",
        "category": "CodePilot"
      },
      {
        "command": "codepilot.switchWorkspace",
        "title": "%codepilot.command.switchWorkspace.title%",
        "category": "CodePilot"
      },
      {
        "command": "codepilot.dockHere",
        "title": "%codepilot.command.dockHere.title%",
        "category": "CodePilot"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codepilot",
          "title": "%codepilot.viewsContainers.codepilot.title%",
          "icon": "media/icon.svg"
        }
      ],
      "secondarySidebar": [
        {
          "id": "codepilot-right",
          "title": "%codepilot.viewsContainers.codepilot.title%",
          "icon": "media/icon.svg"
        }
      ],
      "panel": [
        {
          "id": "codepilot-panel",
          "title": "%codepilot.viewsContainers.codepilot.title%",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "codepilot": [
        {
          "type": "webview",
          "id": "codepilot.chatView",
          "name": "%codepilot.views.chat.name%",
          "contextualTitle": "CodePilot",
          "when": "codepilot.panelPosition == 'left'"
        },
        {
          "id": "codepilot.dock",
          "name": "%codepilot.views.dock.name%",
          "contextualTitle": "CodePilot",
          "when": "codepilot.panelPosition != 'left'"
        }
      ],
      "codepilot-right": [
        {
          "type": "webview",
          "id": "codepilot.chatView.right",
          "name": "%codepilot.views.chat.name%",
          "contextualTitle": "CodePilot",
          "when": "codepilot.panelPosition == 'right'"
        }
      ],
      "codepilot-panel": [
        {
          "type": "webview",
          "id": "codepilot.chatView.panel",
          "name": "%codepilot.views.chat.name%",
          "contextualTitle": "CodePilot",
          "when": "codepilot.panelPosition == 'bottom' || codepilot.panelPosition == 'top'"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "codepilot.dock",
        "contents": "%codepilot.viewsWelcome.dock%"
      }
    ],
    "configuration": {
      "title": "CodePilot",
      "properties": {
        "codepilot.panelPosition": {
          "type": "string",
          "enum": [
            "left",
            "right",
            "bottom",
            "top"
          ],
          "default": "left",
          "enumDescriptions": [
            "%codepilot.config.panelPosition.left%",
            "%codepilot.config.panelPosition.right%",
            "%codepilot.config.panelPosition.bottom%",
            "%codepilot.config.panelPosition.top%"
          ],
          "description": "%codepilot.config.panelPosition%"
        },
        "codepilot.serverPath": {
          "type": "string",
          "default": "codepilot",
          "description": "%codepilot.config.serverPath%"
        },
        "codepilot.cliPath": {
          "type": "string",
          "default": "",
          "description": "%codepilot.config.cliPath%"
        },
        "codepilot.nodePath": {
          "type": "string",
          "default": "node",
          "description": "%codepilot.config.nodePath%"
        },
        "codepilot.engineMode": {
          "type": "string",
          "enum": [
            "shared",
            "stdio"
          ],
          "default": "shared",
          "description": "%codepilot.config.engineMode%"
        },
        "codepilot.permissionMode": {
          "type": "string",
          "enum": [
            "ask",
            "auto-edit",
            "yolo"
          ],
          "default": "ask",
          "description": "%codepilot.config.permissionMode%"
        },
        "codepilot.model": {
          "type": "string",
          "default": "",
          "description": "%codepilot.config.model%"
        },
        "codepilot.provider": {
          "type": "string",
          "enum": [
            "anthropic",
            "openai",
            "copilot",
            ""
          ],
          "default": "",
          "description": "%codepilot.config.provider%"
        },
        "codepilot.systemPromptExtra": {
          "type": "string",
          "default": "",
          "description": "%codepilot.config.systemPromptExtra%"
        },
        "codepilot.autoApprove": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%codepilot.config.autoApprove%"
        },
        "codepilot.showDiff": {
          "type": "boolean",
          "default": true,
          "description": "%codepilot.config.showDiff%"
        },
        "codepilot.protocolVersion": {
          "type": "number",
          "default": 1,
          "description": "%codepilot.config.protocolVersion%"
        },
        "codepilot.agentMode": {
          "type": "string",
          "enum": [
            "chat",
            "plan",
            "agent"
          ],
          "default": "agent",
          "description": "%codepilot.config.agentMode%"
        },
        "codepilot.completion.enabled": {
          "type": "boolean",
          "default": false,
          "description": "%codepilot.config.completion.enabled%"
        },
        "codepilot.completion.debounceMs": {
          "type": "number",
          "default": 200,
          "description": "%codepilot.config.completion.debounceMs%"
        },
        "codepilot.completion.maxTokens": {
          "type": "number",
          "default": 96,
          "description": "%codepilot.config.completion.maxTokens%"
        }
      }
    },
    "keybindings": [
      {
        "command": "codepilot.openSidebar",
        "key": "ctrl+shift+c",
        "mac": "cmd+shift+c",
        "when": "editorTextFocus"
      },
      {
        "command": "codepilot.addToChat",
        "key": "ctrl+shift+l",
        "mac": "cmd+shift+l",
        "when": "editorHasSelection"
      },
      {
        "command": "codepilot.addToNewChat",
        "key": "ctrl+l",
        "mac": "cmd+l",
        "when": "editorHasSelection"
      },
      {
        "command": "codepilot.askSelection",
        "key": "ctrl+shift+a",
        "mac": "cmd+shift+a",
        "when": "editorHasSelection"
      },
      {
        "command": "codepilot.cancel",
        "key": "escape",
        "when": "codepilot.busy"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "codepilot.addToChat",
          "group": "codepilot@1"
        },
        {
          "command": "codepilot.addToNewChat",
          "group": "codepilot@2"
        },
        {
          "command": "codepilot.askSelection",
          "when": "editorHasSelection",
          "group": "codepilot@3"
        }
      ],
      "explorer/context": [
        {
          "command": "codepilot.addToChat",
          "when": "!explorerResourceIsFolder",
          "group": "codepilot@1"
        },
        {
          "command": "codepilot.addToNewChat",
          "when": "!explorerResourceIsFolder",
          "group": "codepilot@2"
        }
      ],
      "editor/title/context": [
        {
          "command": "codepilot.addToChat",
          "group": "codepilot@1"
        },
        {
          "command": "codepilot.addToNewChat",
          "group": "codepilot@2"
        }
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "package": "vsce package --no-dependencies",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@codepilot/protocol": "workspace:*",
    "@codepilot/web": "workspace:*",
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.106.0",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^2.1.8",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
