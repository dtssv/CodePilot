{
  "name": "@codepilot/web",
  "version": "1.0.0",
  "private": true,
  "description": "CodePilot web UI — browser client for the headless protocol over WebSocket.",
  "type": "module",
  "scripts": {
    "build": "vite build && vite build --config vite.embed.config.ts && node scripts/inline-embed.mjs",
    "typecheck": "tsc --noEmit",
    "dev": "vite",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build:embed": "vite build --config vite.embed.config.ts && node scripts/inline-embed.mjs",
    "visual": "tsx test/e2e/visual.ts"
  },
  "dependencies": {
    "@codepilot/protocol": "workspace:*",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@shikijs/engine-javascript": "^4.5.0",
    "@uiw/codemirror-theme-github": "^4.25.1",
    "@uiw/react-codemirror": "^4.25.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "shiki": "^4.5.0"
  },
  "devDependencies": {
    "@codepilot/core": "workspace:*",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.8",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
